{
  "name": "biz-card",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@biz-card/web",
    "dev:mobile": "npm run start --workspace=@biz-card/mobile",
    "ios": "npm run ios --workspace=@biz-card/mobile",
    "android": "npm run android --workspace=@biz-card/mobile",
    "build": "npm run build --workspace=@biz-card/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
