NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FOLLOWUP_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=

# apps/mobile (copy to apps/mobile/.env.local)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WEB_URL=https://www.getknctd.com
# RevenueCat public SDK keys (safe for the mobile client).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Connected sending accounts: WEB SERVER ONLY (never NEXT_PUBLIC / EXPO_PUBLIC).
# Exact production web origin; must match provider callback registrations.
MAILBOX_APP_URL=https://www.getknctd.com
# Generate a 32-byte base64 key: openssl rand -base64 32; preserve securely across deploys.
MAILBOX_ENCRYPTION_KEY=
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
# Random scheduler bearer secret, shared with GitHub Actions. Generate: openssl rand -hex 32
CRON_SECRET=

# Automatic SMS: WEB SERVER ONLY. KNCT owns these credentials; end users never enter Twilio keys.
# The master account credentials may send through approved per-user subaccounts/Messaging Services.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Billing: server only.
# Configure RevenueCat webhooks to send Authorization: Bearer <this value>.
REVENUECAT_WEBHOOK_AUTH=
# Protects /api/admin/pro for complimentary founder/tester access.
KNCT_ADMIN_TOKEN=

# Native iOS push notifications (server only)
APNS_TEAM_ID=
APNS_KEY_ID=
# Contents of the Apple .p8 key. In hosted env vars, use \n for line breaks if needed.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.bizcard.mobile
